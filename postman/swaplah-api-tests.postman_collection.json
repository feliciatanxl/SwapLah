  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const runId = Date.now().toString().slice(-8);",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('ownerStudentId', `S${runId}`);",
          "  pm.collectionVariables.set('ownerEmail', `s${runId}@mymail.nyp.edu.sg`);",
          "  pm.collectionVariables.set('ownerDisplayName', `NewmanOwner${runId}`);",
          "  pm.collectionVariables.set('ownerUpdatedDisplayName', `UpdatedOwner${runId}`);",
          "  pm.collectionVariables.set('otherStudentId', `T${runId}`);",
          "  pm.collectionVariables.set('otherEmail', `t${runId}@mymail.nyp.edu.sg`);",
          "  pm.collectionVariables.set('otherDisplayName', `NewmanOther${runId}`);",
          "  pm.collectionVariables.set('listingTitle', `Newman Laptop ${runId}`);",
          "  pm.collectionVariables.set('updatedListingTitle', `Updated Newman Laptop ${runId}`);",
          "}"
        ]
      }
    }
  ],
